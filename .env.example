# ==========================================================================
# ORIGEM DOS DADOS — ARQUIVO EXCEL
# ==========================================================================
# Opção 1 (recomendada): deixe EXCEL_PATH em branco. O sistema vai procurar
# automaticamente o arquivo EXCEL_FILENAME dentro das pastas do OneDrive
# sincronizadas nesta máquina (pessoal e/ou corporativo).
EXCEL_PATH=

# Nome do arquivo a ser localizado automaticamente quando EXCEL_PATH estiver
# em branco (usado apenas nesse caso).
EXCEL_FILENAME=REDE_B2B.xlsx

# Opcional: restrinja a busca a uma ou mais bibliotecas sincronizadas.
# No Windows, separe vários diretórios com ponto e vírgula. Deixe em branco
# para que cada usuário use automaticamente o próprio OneDrive.
EXCEL_SEARCH_ROOTS=

# Opção 2 (manual): preencha EXCEL_PATH com o caminho completo do arquivo.
# Quando preenchido, ele tem prioridade e a busca automática é ignorada.
# Windows, exemplo: EXCEL_PATH=C:\Users\PEGGY\OneDrive - Telefonica\PROJETO\REDE_B2B.xlsx

# Nome da planilha (aba) dentro do arquivo Excel que contém os dados.
EXCEL_SHEET_NAME=REDEB2B

# Nome da Tabela estruturada do Excel. O CRUD altera somente os valores e
# mantém esta mesma tabela, seu estilo, cores e formatação.
EXCEL_TABLE=REDEB2B

# ==========================================================================
# FLASK
# ==========================================================================
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=troque-esta-chave-em-producao
PORT=5000
